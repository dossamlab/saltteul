<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-add bar 4x1 (design 2026-11-14 section 1.3). Static, so it is also the picker preview. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="3dp">

    <LinearLayout
        android:id="@+id/quick_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_soft"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_quickAdd_hint"
            android:textColor="@color/widget_ink_2"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/quick_mic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/widget_quickAdd_mic">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_round_soft"
                android:importantForAccessibility="no"
                android:scaleType="center"
                android:src="@drawable/widget_mic" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
