<?xml version="1.0" encoding="utf-8"?>
<!-- Undo line under the open routines: a tap unticks the routine last ticked on a widget. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_undo_area"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="36dp">

    <TextView
        android:id="@+id/row_undo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:background="@drawable/widget_pill_terra"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@color/widget_terra"
        android:textSize="12sp" />
</FrameLayout>
