<?xml version="1.0" encoding="utf-8"?>
<!-- Tablet: two open routines as chips; tapping one ticks it. The second chip is hidden on an odd last row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <TextView
        android:id="@+id/row_chip_1"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_chip_both"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/row_chip_2"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:layout_weight="1"
        android:background="@drawable/widget_chip_both"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="@color/widget_ink"
        android:textSize="13sp" />
</LinearLayout>
