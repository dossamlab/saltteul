<?xml version="1.0" encoding="utf-8"?>
<!-- Pantry row: name on top, count / low marker / expiry badge below, −1 button on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_ink"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row_qty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_ink_2"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/row_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/widget_pill_terra"
                android:maxLines="1"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="@string/widget_pantryLow"
                android:textColor="@color/widget_terra"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/row_expiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_terra"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Tap target for −1 (fill-in intent goes here; none when the count is zero). -->
    <FrameLayout
        android:id="@+id/row_minus_area"
        android:layout_width="40dp"
        android:layout_height="40dp">

        <ImageView
            android:id="@+id/row_minus"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center_vertical|end"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_minus" />
    </FrameLayout>
</LinearLayout>
