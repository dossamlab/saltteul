<?xml version="1.0" encoding="utf-8"?>
<!-- Month calendar 4x4 (design 2026-11-14 section 2): header, then the calendar drawn as one bitmap. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="3dp">

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_soft"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp">

            <TextView
                android:id="@+id/cal_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/cal_add"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/widget_calendar_add">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_round_soft"
                    android:importantForAccessibility="no"
                    android:scaleType="center"
                    android:src="@drawable/widget_plus" />
            </FrameLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/cal_image"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/widget_calendar_open"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_soft"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/widget_loading"
        android:textColor="@color/widget_ink_2"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
